# Server Configuration
PORT=3000
NODE_ENV=production

# On Railway, the DATABASE_URL is automatically injected when you link a PostgreSQL database.
# DATABASE_URL=postgresql://postgres:password@host:port/database

# Or individual connection settings:
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=hub_cluster_db
PGSSL=false
