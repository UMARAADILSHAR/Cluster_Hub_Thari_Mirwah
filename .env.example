# ──────────────────────────────────────────────────────────
# Hub Cluster KX03099 — Environment Variables
# Copy this file to .env for local development
# Set these as Environment Variables in Vercel dashboard
# ──────────────────────────────────────────────────────────

# PostgreSQL connection string (preferred — works on Vercel, Railway, Neon, Supabase)
DATABASE_URL=postgresql://postgres:jawadJAAN%401951@localhost:5432/hub_cluster_db

# OR individual fields (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=hub_cluster_db
PGUSER=postgres
PGPASSWORD=jawadJAAN@1951

# Node environment
NODE_ENV=development

# Server port (Vercel ignores this; Railway/local use it)
PORT=3000
